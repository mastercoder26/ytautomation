{
  "mcpServers": {
    "brandpreflight": {
      "command": "node",
      "args": ["./dist/mcp/index.js"],
      "cwd": ".",
      "env_vars": [
        "BRANDPREFLIGHT_WORKSPACE_ROOT",
        "BRANDPREFLIGHT_DATA_DIR",
        "BRANDPREFLIGHT_MEDIA_RUNTIME",
        "BRANDPREFLIGHT_MEDIA_IMAGE",
        "BRANDPREFLIGHT_FFMPEG",
        "BRANDPREFLIGHT_FFPROBE",
        "BRANDPREFLIGHT_WHISPER_COMMAND",
        "BRANDPREFLIGHT_WHISPER_MODEL",
        "BRANDPREFLIGHT_WATCH_SKILL_PATH"
      ]
    }
  }
}
