# Local paths only; do not commit secrets or customer asset paths.
BRANDPREFLIGHT_WORKSPACE_ROOT=/absolute/path/to/creator-assets
BRANDPREFLIGHT_DATA_DIR=/absolute/private/path/to/brandpreflight-artifacts
BRANDPREFLIGHT_MEDIA_RUNTIME=docker
BRANDPREFLIGHT_MEDIA_IMAGE=sha256:<64-hex-local-image-id-or-name@registry-digest>
BRANDPREFLIGHT_FFMPEG=ffmpeg
BRANDPREFLIGHT_FFPROBE=ffprobe
BRANDPREFLIGHT_WHISPER_COMMAND=whisper-cli
BRANDPREFLIGHT_WHISPER_MODEL=/absolute/path/to/ggml-base.en.bin
